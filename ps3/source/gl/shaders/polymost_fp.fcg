/*
 * polymost_fp.fcg -- Polymost's fragment shader (polymost1Frag.glsl, the
 * GL_ARB_shader_texture_lod path, without the gradients) for the RSX. Detail and glow maps (high
 * resolution packs only) aren't done.
 *
 * The uniforms come from the vertex program (polymost_vp.vcg), packed:
 *
 *   TEXCOORD0  xy texture coordinate, z v_distance, w linear fog factor
 *   TEXCOORD1  u_texturePosSize
 *   TEXCOORD2  xy u_halfTexelSize, zw u_clamp
 *   TEXCOORD3  xy u_palswapPos, zw u_palswapSize
 *   TEXCOORD4  x u_shade, yz u_numShades, w u_visFactor
 *   TEXCOORD5  x u_colorCorrection.x - 1 (gamma), y u_useColorOnly,
 *              z u_usePalette, w u_shadeInterpolate
 *   TEXCOORD6  xyz u_npotEmulation (w is 1 / y), w contrast
 *   TEXCOORD7  rgb fog color, w saturation
 */

float4 main(
    float4 t0   : TEXCOORD0,
    float4 tps  : TEXCOORD1,
    float4 htc  : TEXCOORD2,
    float4 psw  : TEXCOORD3,
    float4 sh   : TEXCOORD4,
    float4 fl   : TEXCOORD5,
    float4 npot : TEXCOORD6,
    float4 fogc : TEXCOORD7,
    float4 vcol : COLOR0,

    uniform sampler2D s_texture : TEXUNIT0,
    uniform sampler2D s_palswap : TEXUNIT1,
    uniform sampler2D s_palette : TEXUNIT2
) : COLOR
{
    float2 tc = t0.xy;
    float usePalette = fl.z;

    /* NPOT emulation (GLSL mod(a, b) = a - b * floor(a / b)) */
    float2 coord = lerp(tc, tc.yx, usePalette);
    float rows = floor(coord.y / npot.y);
    float m = coord.y - npot.y * rows;
    coord = float2(floor(m) * npot.x + coord.x, rows + m);
    float2 newCoord = lerp(tc, lerp(coord, coord.yx, usePalette), npot.z);

    float2 texCoord = lerp(frac(newCoord), saturate(newCoord), htc.zw);
    texCoord = clamp(tps.zw * texCoord, htc.xy, tps.zw - htc.xy);
    /* (GLSL: texture2DGradARB with the derivatives of tc. PSL1GHT's
       cgcomp drops TXD without a word, and the tilesheets have one level
       and GL_NEAREST anyway: a plain lookup.) */
    float4 color = tex2D(s_texture, tps.xy + texCoord);

    /* palette: shade table, then base palette */
    float shade = clamp(sh.x + clamp(sh.w * t0.z - 0.5 * fl.w, 0.0, sh.y), 0.0, sh.y - 1.0);
    float shadeFloor = floor(shade);
    float shadeFrac = shade - shadeFloor;
    float colorIndex = tex2D(s_palswap, float2(color.r, shadeFloor * sh.z) * psw.zw + psw.xy).r *
        (255.0 / 256.0) + (0.5 / 256.0);
    float colorIndexNext = tex2D(s_palswap, psw.zw * float2(color.r, (shadeFloor + 1.0) * sh.z) + psw.xy).r *
        (255.0 / 256.0) + (0.5 / 256.0);
    float4 palettedColor = tex2D(s_palette, float2(colorIndex, 0.0));
    float4 palettedColorNext = tex2D(s_palette, float2(colorIndexNext, 0.0));
    palettedColor.rgb = lerp(palettedColor.rgb, palettedColorNext.rgb, shadeFrac * fl.w);
    float fullbright = lerp(usePalette * palettedColor.a, 0.0, fl.y);
    palettedColor.a = 1.0 - floor(color.r);
    color = lerp(color, palettedColor, usePalette);

    color = lerp(color, float4(1.0, 1.0, 1.0, 1.0), fl.y);
    color.rgb = lerp(vcol.rgb * color.rgb, color.rgb, fullbright);

    /* fog (t0.w is huge with fog off: the factor clamps to 1) */
    float fogFactor = clamp(t0.w, fullbright, 1.0);
    color.rgb = lerp(fogc.rgb, color.rgb, fogFactor);

    color.a *= vcol.a;

    /* u_colorCorrection: saturation, contrast, then brightness (the GLSL
       matrix product written out) */
    float luma = dot(color.rgb, float3(0.2126, 0.7152, 0.0722));
    color.rgb = lerp(float3(luma, luma, luma), color.rgb, fogc.w);
    color.rgb = npot.w * color.rgb + (0.5 * (1.0 - npot.w)) * color.a;
    color.rgb = color.rgb + fl.x * color.a;

    return color;
}
